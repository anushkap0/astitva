# Add fake configuration keys required to run your solution.
# Never commit .env, credentials, tokens, or real identity data.
# ---------------------------------------------------------------
# ASTITVA environment template. Copy to .env and adjust.
# All values below are for local demo use only.

# development | test | production
# production refuses to start with the dev-only secrets below,
# forces Secure cookies and disables the simulated mailbox.
APP_ENV=development

# Postgres (docker-compose creates this database)
POSTGRES_USER=astitva
POSTGRES_PASSWORD=astitva
POSTGRES_DB=astitva
# Used when running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://astitva:astitva@localhost:5432/astitva
REDIS_URL=redis://localhost:6379/0

# Secrets: generate with `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=dev-only-change-me-astitva-jwt-secret-0000000000
# Peppers token digests and derives the Fernet key for TOTP secrets / token re-reveal
TOKEN_PEPPER=dev-only-change-me-astitva-pepper

# Cookies / CORS
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
CORS_ORIGINS=http://localhost:3000

# Brute-force protection (defaults shown)
LOGIN_MAX_FAILURES=5
LOCKOUT_BASE_SECONDS=60
LOCKOUT_MAX_SECONDS=1800

# Governance
RECERTIFICATION_INTERVAL_DAYS=30
BREAKGLASS_DEFAULT_MINUTES=60
BREAKGLASS_MAX_MINUTES=240

# Optional AI explanations: none | anthropic | openai (OpenAI-compatible)
# The AI only explains and recommends. It never grants access.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=

# Dev conveniences
EXPOSE_DEV_OUTBOX=true
ENABLE_INPROCESS_SCHEDULER=true
SEED_DEMO=true

# Frontend
BACKEND_URL=http://localhost:8000
# Leave empty to use ws://<host>:8000
NEXT_PUBLIC_WS_URL=

# NamoID Hosted Auth (OpenID Connect, Authorization Code + PKCE).
# Issuer and Client ID are public values from the NamoID Console (this is the
# sandbox test app). NAMOID_CLIENT_SECRET stays empty here: if your app has one,
# put it ONLY in your local .env. Leave it empty for a public client (PKCE only).
NAMOID_ISSUER=https://astitva-0efc7e.sandbox.namoid.in
NAMOID_CLIENT_ID=namoid_client_test_o2cLBiO3v9pcfKb2os5nn4ORagvF5RdI
NAMOID_CLIENT_SECRET=
# Must match the callback URL registered in the NamoID Console exactly.
NAMOID_REDIRECT_URI=http://localhost:8000/api/auth/namoid/callback
# Where the browser goes after sign-in
FRONTEND_URL=http://localhost:3000
# Optional demo linking: NamoID email = ASTITVA demo account, comma separated, e.g.
# NAMOID_USER_MAP=you+req@example.com=kavya.reddy@nexora.example,you+mgr@example.com=priya.desai@nexora.example
NAMOID_USER_MAP=
# Unknown NamoID users are created on first sign-in (as Employee if NamoID sends no role)
NAMOID_AUTO_PROVISION=true
# Roles from NamoID: roles assigned in the NamoID Console (requester, manager, risk_reviewer,
# resource_owner, security_manager) become the user's ASTITVA roles at every sign-in.
NAMOID_ROLE_SYNC=true
# Leave empty to auto-detect (roles / groups / organizations[].roles ...). Set a claim
# name or dotted path, e.g. NAMOID_ROLES_CLAIM=app_metadata.roles, if NamoID uses another place.
NAMOID_ROLES_CLAIM=
# Scopes requested from NamoID. Add "organizations" if your roles are organization roles.
NAMOID_SCOPES="openid profile email"
